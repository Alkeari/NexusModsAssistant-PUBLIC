{
  "name": "nexus-mods-assistant",
  "version": "3.4.0",
  "description": "Nexus Mods Assistant - TypeScript Browser Extension",
  "scripts": {
    "build": "cross-env BROWSER=chrome webpack --mode production",
    "build:all": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "cross-env BROWSER=chrome webpack --mode production && npm run package:chrome",
    "build:firefox": "cross-env BROWSER=firefox webpack --mode production && npm run package:firefox",
    "clean": "rimraf dist dist-chrome dist-firefox packages .nma-state web-ext-artifacts",
    "creds:check": "node scripts/creds-check.js",
    "dev": "node scripts/dev.js chrome",
    "dev:chrome": "node scripts/dev.js chrome",
    "dev:firefox": "node scripts/dev.js firefox",
    "hooks:install": "git config core.hooksPath .githooks",
    "hooks:uninstall": "git config --unset core.hooksPath",
    "lint:firefox": "web-ext lint --source-dir dist-firefox --no-input --no-config-discovery",
    "listing:sync": "node scripts/sync-amo-listing.js",
    "local": "node scripts/local.js chrome",
    "local:chrome": "node scripts/local.js chrome",
    "local:firefox": "node scripts/local.js firefox",
    "package:chrome": "node scripts/package.js chrome",
    "package:firefox": "node scripts/package.js firefox",
    "package:nexus": "node scripts/package-nexus.js",
    "package:source": "node scripts/package-source.js",
    "preflight": "node scripts/preflight.js --scope release",
    "preflight:local": "node scripts/preflight.js --scope local",
    "release:dry": "node scripts/release.js --dry-run",
    "status": "node scripts/store-status.js",
    "test": "node --test \"tests/*.test.js\"",
    "type-check": "tsc --noEmit",
    "version:check": "node scripts/version.js check",
    "version:sync": "node scripts/version.js sync",
    "locales": "node scripts/merge-locales.js",
    "locales:check": "node scripts/merge-locales.js --check"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "archiver": "^7.0.1",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^7.0.3",
    "rimraf": "^5.0.5",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "web-ext": "^10.6.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  }
}
